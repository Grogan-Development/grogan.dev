[Unit]
Description=Nero seat compositor (openbox on DISPLAY=:1)
After=kasmvnc.service
Requires=kasmvnc.service
BindsTo=kasmvnc.service

[Service]
Type=simple
User=nero
Group=nero
WorkingDirectory=/home/nero
Environment=HOME=/home/nero
Environment=USER=nero
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/nero/.Xauthority
ExecStartPre=/usr/lib/nero/wait-for-display
ExecStart=/usr/bin/openbox --startup /usr/lib/nero/openbox-startup
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
