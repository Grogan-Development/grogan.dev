[Unit]
Description=Nero workspace daemon
# Node ESM entry copied to /usr/local/bin/nero-daemon (shebang). The image
# install in a later PR copies apps/daemon/dist/main.js to that path.
ConditionPathExists=/usr/local/bin/nero-daemon
After=network.target user@1000.service
Wants=user@1000.service

[Service]
Type=simple
User=nero
Group=nero
WorkingDirectory=/home/nero
Environment=HOME=/home/nero
Environment=USER=nero
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=NERO_HOME=/home/nero
Environment=NERO_WORKSPACE=/home/nero
Environment=NERO_DATA_DIR=/home/nero/.nero
Environment=PORT=8787
ExecStart=/usr/local/bin/nero-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
