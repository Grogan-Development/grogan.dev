[Unit]
Description=Nero workspace daemon
ConditionPathExists=/usr/local/bin/nero-daemon
After=network.target user@1000.service nero-container-env.service
Wants=user@1000.service
Requires=nero-container-env.service

[Service]
Type=simple
User=nero
Group=nero
WorkingDirectory=/home/nero
Environment=HOME=/home/nero
Environment=USER=nero
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=NERO_HOME=/home/nero
Environment=NERO_WORKSPACE=/home/nero/workspace
Environment=NERO_DATA_DIR=/home/nero/.nero
Environment=NERO_SEAT_LOCK=/run/nero/seat.lock
Environment=NERO_HOST=0.0.0.0
Environment=PORT=8787
Environment=NODE_PATH=/usr/lib/nero/daemon/node_modules
EnvironmentFile=-/etc/nero/guest.env
PassEnvironment=ZAI_API_KEY ZAI_BASE_URL BASETEN_API_KEY NERO_ACCESS_TOKEN NERO_HOST_TOKEN NERO_WORKSPACE_ID NERO_ENVIRONMENT_ID NERO_LABEL
ExecStart=/usr/local/bin/nero-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
