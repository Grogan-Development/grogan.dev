#!/bin/sh
# Register a keep-awake job: a systemd --user scope under nero-job.slice.
# Live cgroup: user@1000.service/nero-job.slice/ (not a system slice).
# Stray processes (unnamed daemons, tmux, etc.) are not jobs.
set -eu

usage() {
  echo "usage: nero-run command [args...]" >&2
  echo "env: NERO_JOB_ID   optional unit suffix (nero-job-<id>.scope)" >&2
  echo "     NERO_RUN_DRY=1  print systemd-run argv and exit" >&2
  exit 2
}

[ "$#" -ge 1 ] || usage

cmd=$1
shift

uid=$(id -u)
: "${XDG_RUNTIME_DIR:=/run/user/${uid}}"
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"
: "${DISPLAY:=:1}"
export XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS DISPLAY

unit_args=""
if [ -n "${NERO_JOB_ID:-}" ]; then
  case "$NERO_JOB_ID" in
    *[!A-Za-z0-9_-]*)
      echo "nero-run: NERO_JOB_ID must be alphanumeric, _ or -" >&2
      exit 2
      ;;
  esac
  unit_args="--unit=nero-job-${NERO_JOB_ID}.scope"
fi

bus="${XDG_RUNTIME_DIR}/bus"
# Same -p set the real job uses. User manager in Docker may reject resource
# properties; slice + container memory.max still fence the pig.
resource_args="-p MemoryHigh=48G -p MemoryMax=64G -p CPUWeight=100"

if [ "${NERO_RUN_DRY:-}" != 1 ]; then
  if [ ! -S "$bus" ]; then
    echo "nero-run: cannot connect to user bus at ${bus} (need linger / user@${uid}.service)" >&2
    exit 1
  fi
  # shellcheck disable=SC2086
  if ! systemd-run --user --quiet --scope --slice=nero-job.slice \
      $resource_args --collect -- true; then
    resource_args=""
  fi
fi

if [ "${NERO_RUN_DRY:-}" = 1 ]; then
  # Intentionally unquoted resource/unit args so empty values disappear.
  # shellcheck disable=SC2086
  echo systemd-run --user --scope --slice=nero-job.slice \
    $resource_args --collect $unit_args -- "$cmd" "$@"
  exit 0
fi

load_guest_env() {
  if [ -z "${NERO_HOST_TOKEN:-}" ] && [ -r /etc/nero/guest.env ]; then
    # shellcheck disable=SC1091
    set -a
    . /etc/nero/guest.env
    set +a
  fi
}

job_heartbeat() {
  running=$1
  load_guest_env
  [ -n "${NERO_HOST_TOKEN:-}" ] || return 0
  [ -n "${NERO_WORKSPACE_ID:-}" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  host="${NERO_HOST_URL:-http://host.docker.internal:8080}"
  curl -fsS --max-time 5 \
    -X POST \
    -H "Authorization: Bearer ${NERO_HOST_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"running\":${running}}" \
    "${host}/api/workspaces/${NERO_WORKSPACE_ID}/job-heartbeat" >/dev/null 2>&1 || true
}

hb_pid=""
stop_heartbeat() {
  trap - EXIT INT TERM
  if [ -n "${hb_pid}" ]; then
    kill "${hb_pid}" 2>/dev/null || true
    wait "${hb_pid}" 2>/dev/null || true
    hb_pid=""
  fi
  job_heartbeat false
}

job_heartbeat true
(
  while sleep 30; do
    job_heartbeat true
  done
) &
hb_pid=$!
trap stop_heartbeat EXIT INT TERM

# shellcheck disable=SC2086
systemd-run --user --scope --slice=nero-job.slice \
  $resource_args --collect $unit_args -- "$cmd" "$@"
