#!/bin/sh
# vncserver (KasmVNC 1.5.0) only reads $HOME/.kasmpasswd; the yaml
# kasm_password_file is applied to Xvnc after that check. ZFS over /home/nero
# hides the image home, so copy the seed if the dataset is empty.
set -eu
HOME="${HOME:-/home/nero}"

if [ ! -f /etc/nero/kasmpasswd ]; then
  echo "seed-home: missing /etc/nero/kasmpasswd" >&2
  exit 1
fi
if [ ! -f "$HOME/.kasmpasswd" ]; then
  cp /etc/nero/kasmpasswd "$HOME/.kasmpasswd"
  chmod 600 "$HOME/.kasmpasswd"
fi

mkdir -p "$HOME/.vnc"
chmod 700 "$HOME/.vnc"
# Quiet DE selection on an empty dataset.
touch "$HOME/.vnc/.de-was-selected"
# Native agent skills ship in the image (/usr/lib/nero/skills) and are
# refreshed into the persistent dataset when the image copy is newer, so an
# updated image upgrades existing workspaces while user edits (newer mtime)
# survive.
if [ -d /usr/lib/nero/skills ]; then
  for skill in /usr/lib/nero/skills/*; do
    [ -d "$skill" ] || continue
    name=$(basename "$skill")
    target="$HOME/.nero/skills/$name"
    if [ ! -f "$target/SKILL.md" ] || [ "$skill/SKILL.md" -nt "$target/SKILL.md" ]; then
      mkdir -p "$target"
      cp -r "$skill/." "$target/"
    fi
  done
fi
# The agent's bash cwd / file-tree root is its own folder; $HOME keeps only
# harness plumbing (.nero state, .vnc, .kasmpasswd) the UI never shows.
mkdir -p "$HOME/workspace"
# Login shells (bash -l) read .profile, not .bashrc (whose interactive guard
# skips PATH exports). Seed it so non-interactive tool PATHs stick.
if [ ! -f "$HOME/.profile" ]; then
  cat > "$HOME/.profile" <<'PROFILE'
# ~/.profile — sourced by login shells (bash -l). Tool PATHs live here
# because ~/.bashrc's interactive guard skips them otherwise.
if [ -d "$HOME/tools/bin" ]; then
  PATH="$HOME/tools/bin:$PATH"
fi
PROFILE
fi
