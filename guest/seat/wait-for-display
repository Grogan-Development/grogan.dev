#!/bin/sh
# Block until DISPLAY (default :1) answers. Used by nero-seat.service.
set -eu
DISPLAY="${DISPLAY:-:1}"
export DISPLAY
i=0
while [ "$i" -lt 100 ]; do
  if xdpyinfo >/dev/null 2>&1; then
    exit 0
  fi
  i=$((i + 1))
  sleep 0.1
done
echo "wait-for-display: $DISPLAY did not come up" >&2
exit 1
