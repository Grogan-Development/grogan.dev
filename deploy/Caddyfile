# Nero v1 — Grid-01
# TLS via Caddy defaults (Let's Encrypt). Set NERO_ACME_EMAIL if you want a contact on the account.
#
# grogan.dev      landing + AuthKit start (GET /auth/login, /auth/callback, /auth/logout)
# www.grogan.dev  → grogan.dev
# nero.grogan.dev skin + control plane + workspace proxy
#   /                 adapted web (file_server of /var/lib/nero/web)
#   /w/:id/           SPA; daemon prefixes reverse_proxy to the workspace
#   /auth.md          public skill (canonical on this host; humans stay AuthKit-only)
#
# Workspace mapping (host landlord):
#   docker publish  127.0.0.1:<ephemeral>:8787  (container Nero daemon)
#   unix socket     /run/nero/w/<id>.sock       (host forwarder → that port)
# Caddy reverse_proxies to the unix socket (id from the path / cookie / Referer,
# not from a client-supplied header). forward_auth checks wos-session and sets
# X-Nero-Access (not Authorization) so KasmVNC Basic + cookies survive /vnc.
# Cookie wos-session is stripped on the guest hop; other cookies pass through.

(nero_daemon_proxy) {
	vars dial unix//run/nero/w/{vars.workspace_id}.sock
	request_header -X-Nero-Dial
	request_header -X-Nero-Access
	forward_auth 127.0.0.1:8080 {
		uri /internal/caddy-auth
		header_up X-Nero-Workspace {vars.workspace_id}
		copy_headers X-Nero-Access
	}
	reverse_proxy {vars.dial} {
		header_up Cookie "(?:^|;\\s*)wos-session=[^;]*;?\\s*" ""
		header_up -X-Nero-Dial
		header_up -X-Nero-Workspace
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
			dial_timeout 10s
		}
	}
}

www.grogan.dev {
	redir https://grogan.dev{uri} permanent
}

grogan.dev {
	encode gzip
	# Landing + AuthKit only. The control plane (/api/workspaces) and the
	# forward_auth endpoint (/internal/caddy-auth, which mints X-Nero-Access)
	# belong to nero.grogan.dev; proxying them from the public landing host
	# would publish privileged control surfaces on two domains.
	@host_control_plane path /internal/* /api/*
	respond @host_control_plane 404
	reverse_proxy 127.0.0.1:8080
}

nero.grogan.dev {
	encode gzip

	handle /auth.md {
		reverse_proxy 127.0.0.1:8080
	}

	handle /auth/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}

	handle /api/workspaces* {
		reverse_proxy 127.0.0.1:8080
	}

	@ws_daemon path_regexp ws_daemon ^/w/([0-9a-f]+)/(ws|vnc|websockify|api|oauth|\.well-known)(/.*)?$
	handle @ws_daemon {
		route {
			vars workspace_id {re.ws_daemon.1}
			header Set-Cookie "nero-ws={vars.workspace_id}; Path=/w/{vars.workspace_id}; Secure; HttpOnly; SameSite=Lax"
			header +Set-Cookie "nero-ws={vars.workspace_id}; Path=/; Secure; HttpOnly; SameSite=Lax"
			rewrite * /{re.ws_daemon.2}{re.ws_daemon.3}
			import nero_daemon_proxy
		}
	}

	@root_daemon {
		path /ws /ws/* /vnc /vnc/* /websockify /websockify/* /oauth /oauth/* /.well-known /.well-known/* /api /api/*
		not path /api/workspaces /api/workspaces/*
	}
	handle @root_daemon {
		route {
			vars workspace_id {http.request.cookie.nero-ws}
			import nero_daemon_proxy
		}
	}

	@spa_ws path_regexp spa_ws ^/w/([0-9a-f]+)(/.*)?$
	handle @spa_ws {
		header Set-Cookie "nero-ws={re.spa_ws.1}; Path=/w/{re.spa_ws.1}; Secure; HttpOnly; SameSite=Lax"
		header +Set-Cookie "nero-ws={re.spa_ws.1}; Path=/; Secure; HttpOnly; SameSite=Lax"
		root * /var/lib/nero/web
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /var/lib/nero/web
		try_files {path} /index.html
		file_server
	}
}
