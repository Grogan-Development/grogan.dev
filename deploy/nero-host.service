[Unit]
Description=Nero host landlord
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/nero/host.env
# /run/nero/w must be traversable by the caddy group (sockets below are
# 0660 root:caddy). tmpfiles (deploy/tmpfiles/nero-host.conf) creates it at
# boot; these ExecStartPre lines self-heal if that file is not installed.
# UMask=0077 below would otherwise leave the dir root-only after a reboot.
ExecStartPre=/bin/mkdir -p /run/nero/w
ExecStartPre=/bin/chmod 0755 /run/nero
ExecStartPre=-/bin/chgrp caddy /run/nero/w
ExecStartPre=/bin/chmod 0750 /run/nero/w
ExecStart=/usr/local/bin/nero-host
# docker.service restart SIGTERMs us (exit 0). always bring the landlord back.
Restart=always
RestartSec=2
# Root is required (zfs, docker CLI, cgroupfs writes, socket chown), so keep
# what hardening the privileged workspaces still allow. Note: workspace
# containers run --privileged by design (guest systemd + cgroup scopes), so a
# guest escape is effectively host root — see deploy/README.md.
NoNewPrivileges=yes
ProtectHome=read
ProtectSystem=full
PrivateTmp=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
